{
  "name": "Focus mode",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "./draw.png"
  },
  "background":{
    "service_worker":"./serviceWorker.js"
  },
  "permissions":["activeTab","scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+B",
        "linux":"Ctrl+Q"
      }
    }
  }
}